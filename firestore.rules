rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return isSignedIn() && (
        (resource != null && request.auth.uid in resource.data.get('members', [])) || 
        request.auth.uid == coupleId
      );
    }

    function canJoin(coupleId) {
      return isSignedIn() && 
             isValidId(coupleId) &&
             resource != null &&
             resource.data.get('members', []).size() == 1 &&
             incoming().get('members', []).size() == 2 &&
             incoming().get('members', []).hasAll(resource.data.get('members', [])) &&
             request.auth.uid in incoming().get('members', []);
    }

    function isMemberIncoming(coupleId) {
      return isSignedIn() && (
        (request.resource != null && request.auth.uid in request.resource.data.get('members', [])) || 
        request.auth.uid == coupleId
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Memory Validation
    function isValidMemory(data) {
      return data.keys().hasAll(['date', 'userId', 'content', 'images', 'authorName', 'authorImage', 'createdAt', 'updatedAt']) &&
             (data.keys().size() == 8 || (data.keys().size() == 9 && data.keys().hasAll(['title']))) &&
             data.date is string &&
             data.userId is string &&
             data.authorName is string &&
             (data.authorImage == null || data.authorImage is string) &&
             data.content is string &&
             data.images is list &&
             (!('title' in data) || data.title is string);
    }

    // Profile Validation
    function isValidProfile(data) {
      return data.keys().hasAll(['partner1', 'partner2', 'startDate', 'members', 'updatedAt']) &&
             data.partner1 is string && data.partner1.size() <= 100 &&
             data.partner2 is string && data.partner2.size() <= 100 &&
             data.startDate is string &&
             data.members is list &&
             (data.updatedAt == request.time || data.updatedAt == null); // Allow null if not set yet, though App sets it
    }

    match /couples/{coupleId} {
      function isParentMemberLocal(cid) {
        let parentPath = /databases/$(database)/documents/couples/$(cid);
        return exists(parentPath) && (
          request.auth.uid in get(parentPath).data.get('members', []) || 
          request.auth.uid == cid
        );
      }

      allow list: if isSignedIn() && (resource != null && request.auth.uid in resource.data.get('members', []));
      allow get: if isSignedIn() && (isMember(coupleId) || isValidId(coupleId)); 
      allow create: if isSignedIn() && isMemberIncoming(coupleId) && isValidId(coupleId) && isValidProfile(incoming());
      allow update: if isSignedIn() && (isMember(coupleId) || canJoin(coupleId)) && isValidId(coupleId) && isValidProfile(incoming()) && (
        incoming().diff(resource.data).affectedKeys().hasOnly(['partner1', 'partner2', 'startDate', 'members', 'coverImage', 'partner1Image', 'partner2Image', 'frameHeadline', 'frameDate', 'frameQuote', 'updatedAt']) &&
        incoming().updatedAt == request.time
      );
      allow delete: if isSignedIn() && request.auth.uid == coupleId;

      match /memories/{memoryId} {
        allow list: if isSignedIn() && isParentMemberLocal(coupleId);
        allow get: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(memoryId);
        allow create: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(memoryId) && 
                         isValidMemory(incoming()) && 
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;
        allow update: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(memoryId) && 
                         isValidMemory(incoming()) && (
          incoming().diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'images', 'updatedAt']) &&
          incoming().updatedAt == request.time &&
          incoming().createdAt == resource.data.createdAt &&
          incoming().userId == resource.data.userId
        );
        allow delete: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(memoryId);
      }

      match /anniversaries/{anniversaryId} {
        function isValidAnniversary(data) {
          return data.keys().hasAll(['label', 'date', 'userId', 'createdAt']) &&
                 data.keys().size() == 4 &&
                 data.label is string && data.label.size() <= 100 &&
                 data.date is string &&
                 data.userId is string;
        }

        allow list: if isSignedIn() && isParentMemberLocal(coupleId);
        allow create: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(anniversaryId) && 
                         isValidAnniversary(incoming()) && 
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt == request.time;
        allow delete: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(anniversaryId);
      }

      // 청첩장 내용: 커플 멤버만 읽고 쓸 수 있음
      match /invitation/{docId} {
        allow read: if isSignedIn() && isParentMemberLocal(coupleId);
        allow write: if isSignedIn() && isParentMemberLocal(coupleId) && docId == 'main' &&
                        incoming().keys().hasOnly(['content', 'gallery', 'updatedAt']) &&
                        incoming().content is map &&
                        incoming().gallery is list && incoming().gallery.size() <= 60 &&
                        incoming().updatedAt == request.time;
      }

      // 청첩장 사진 (압축된 data URL): 커플 멤버만 읽고 쓸 수 있음
      match /invitationPhotos/{photoId} {
        allow read: if isSignedIn() && isParentMemberLocal(coupleId);
        allow create, update: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(photoId) &&
                                 incoming().keys().hasOnly(['data', 'updatedAt']) &&
                                 incoming().data is string && incoming().data.size() < 1000000 &&
                                 incoming().updatedAt == request.time;
        allow delete: if isSignedIn() && isParentMemberLocal(coupleId);
      }

      match /guestbook/{entryId} {
        function isValidGuestbookEntry(data) {
          return data.keys().hasAll(['name', 'message', 'userId', 'createdAt']) &&
                 data.keys().size() == 4 &&
                 data.name is string && data.name.size() > 0 && data.name.size() <= 30 &&
                 data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
                 data.userId is string;
        }

        allow list: if isSignedIn() && isParentMemberLocal(coupleId);
        allow create: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(entryId) &&
                         isValidGuestbookEntry(incoming()) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt == request.time;
        allow delete: if isSignedIn() && isParentMemberLocal(coupleId) && resource.data.userId == request.auth.uid;
      }

      match /notifications/{notificationId} {
        function isValidNotification(data) {
          return data.keys().hasAll(['type', 'title', 'message', 'userId', 'read', 'createdAt']) &&
                 data.keys().hasOnly(['type', 'title', 'message', 'userId', 'read', 'createdAt', 'targetDate', 'targetId']) &&
                 (!('targetDate' in data) || data.targetDate is string) &&
                 (!('targetId' in data) || data.targetId is string) &&
                 data.type in ['memory_saved', 'anniversary_added'] &&
                 data.title is string &&
                 data.message is string &&
                 data.userId is string &&
                 data.read is bool;
        }

        allow list: if isSignedIn() && isParentMemberLocal(coupleId);
        allow create: if isSignedIn() && isParentMemberLocal(coupleId) && isValidId(notificationId) && 
                         isValidNotification(incoming()) && 
                         incoming().createdAt == request.time;
        allow update: if isSignedIn() && isParentMemberLocal(coupleId) && 
                         incoming().diff(resource.data).affectedKeys().hasOnly(['read']) &&
                         isValidNotification(incoming());
        allow delete: if isSignedIn() && isParentMemberLocal(coupleId);
      }
    }
  }
}
